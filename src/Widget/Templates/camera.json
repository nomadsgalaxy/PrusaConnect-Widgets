{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "body": [
    {
      "type": "Image",
      "url": "${accentBar}",
      "width": "stretch",
      "height": "6px",
      "spacing": "None",
      "altText": ""
    },
    {
      "type": "ColumnSet",
      "columns": [
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "TextBlock",
              "text": "${printerName}",
              "weight": "Bolder",
              "size": "Medium",
              "wrap": false,
              "maxLines": 1
            }
          ]
        },
        {
          "type": "Column",
          "width": "auto",
          "verticalContentAlignment": "Center",
          "items": [
            {
              "type": "TextBlock",
              "text": "${stateLabel}",
              "color": "${stateColor}",
              "weight": "Bolder",
              "size": "Small",
              "horizontalAlignment": "Right"
            }
          ]
        }
      ]
    },
    {
      "$when": "${hasImage}",
      "type": "Image",
      "url": "${cameraUrl}",
      "horizontalAlignment": "Center",
      "spacing": "Medium",
      "size": "Stretch",
      "altText": "Camera snapshot"
    },
    {
      "$when": "${hasNote}",
      "type": "TextBlock",
      "text": "${note}",
      "wrap": true,
      "isSubtle": true,
      "size": "Small",
      "spacing": "Medium",
      "horizontalAlignment": "Center"
    }
  ]
}
