{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "body": [
    {
      "type": "Image",
      "url": "${accentBar}",
      "width": "stretch",
      "height": "6px",
      "spacing": "None",
      "altText": ""
    },
    {
      "type": "ColumnSet",
      "spacing": "Small",
      "columns": [
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            { "type": "TextBlock", "text": "${headerTitle}", "weight": "Bolder", "size": "Medium", "color": "Good", "spacing": "None" },
            { "type": "TextBlock", "text": "${totalLabel}", "size": "Small", "isSubtle": true, "spacing": "None" }
          ]
        },
        {
          "type": "Column",
          "width": "auto",
          "verticalContentAlignment": "Center",
          "items": [
            { "type": "TextBlock", "text": "${updatedLabel}", "size": "Small", "isSubtle": true, "horizontalAlignment": "Right" }
          ]
        }
      ]
    },
    {
      "type": "Container",
      "height": "stretch",
      "verticalContentAlignment": "Center",
      "items": [
        {
          "type": "ColumnSet",
          "spacing": "Medium",
          "columns": [
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                { "type": "TextBlock", "text": "Printing", "size": "Small", "isSubtle": true, "spacing": "None", "horizontalAlignment": "Center" },
                { "type": "TextBlock", "text": "${printing}", "weight": "Bolder", "size": "ExtraLarge", "color": "Warning", "spacing": "None", "horizontalAlignment": "Center" }
              ]
            },
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                { "type": "TextBlock", "text": "Idle", "size": "Small", "isSubtle": true, "spacing": "None", "horizontalAlignment": "Center" },
                { "type": "TextBlock", "text": "${idle}", "weight": "Bolder", "size": "ExtraLarge", "spacing": "None", "horizontalAlignment": "Center" }
              ]
            },
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                { "type": "TextBlock", "text": "Attention", "size": "Small", "isSubtle": true, "spacing": "None", "horizontalAlignment": "Center" },
                { "type": "TextBlock", "text": "${attention}", "weight": "Bolder", "size": "ExtraLarge", "color": "Attention", "spacing": "None", "horizontalAlignment": "Center" }
              ]
            },
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                { "type": "TextBlock", "text": "Offline", "size": "Small", "isSubtle": true, "spacing": "None", "horizontalAlignment": "Center" },
                { "type": "TextBlock", "text": "${offline}", "weight": "Bolder", "size": "ExtraLarge", "isSubtle": true, "spacing": "None", "horizontalAlignment": "Center" }
              ]
            }
          ]
        }
      ]
    }
  ]
}
