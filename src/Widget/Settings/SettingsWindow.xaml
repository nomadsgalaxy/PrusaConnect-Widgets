<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PrusaConnect.Widget.Settings.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Prusa Connect Widget - Settings">

    <ScrollViewer HorizontalScrollMode="Disabled">
        <Grid Padding="32" RowSpacing="20" MaxWidth="900" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- 0: header -->
                <RowDefinition Height="Auto" /> <!-- 1: saved printers list -->
                <RowDefinition Height="Auto" /> <!-- 2: editor form (collapsed by default) -->
                <RowDefinition Height="Auto" /> <!-- 3: cloud import section -->
                <RowDefinition Height="Auto" /> <!-- 4: footer -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Spacing="2">
                <TextBlock Text="PRUSA" FontSize="44" FontWeight="Black" />
                <TextBlock Text="Connect Widget - Printer Configuration"
                           Opacity="0.6" FontSize="14" />
            </StackPanel>

            <!-- Saved printers (the catalogue) - each row is an inline Expander
                 that unfolds to reveal its own editor form. -->
            <StackPanel Grid.Row="1" Spacing="12" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="Saved printers"
                                   FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Click a row to expand and edit. Remove deletes the saved config and credentials."
                                   Opacity="0.6" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Add new"
                            VerticalAlignment="Top"
                            Click="OnAddNewClick" />
                </Grid>
                <StackPanel x:Name="SavedPrintersHost" Spacing="6" />

                <!-- Shared status bar at bottom of list - surfaces save/remove/test results. -->
                <InfoBar x:Name="StatusBar"
                         IsOpen="False" IsClosable="True"
                         Severity="Informational">
                    <InfoBar.ActionButton>
                        <Button x:Name="CopyStatusButton"
                                Content="Copy"
                                Click="OnCopyStatusClick"
                                Visibility="Collapsed" />
                    </InfoBar.ActionButton>
                </InfoBar>
            </StackPanel>

            <!-- Pinned tiles - read-only view of what's currently on the Widgets Board -->
            <StackPanel Grid.Row="2" Spacing="12" Margin="0,16,0,0">
                <Border Background="{ThemeResource SystemControlForegroundBaseLowBrush}"
                        Height="1" Margin="0,0,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="Pinned tiles" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Widgets currently on your Windows Widgets Board (Win+W). Each row shows which printer the tile is bound to and its last reported state."
                                   Opacity="0.6" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Refresh"
                            VerticalAlignment="Top"
                            Click="OnRefreshPinnedTilesClick" />
                </Grid>
                <StackPanel x:Name="PinnedTilesHost" Spacing="6" />
            </StackPanel>

            <!-- Prusa Connect cloud import section -->
            <StackPanel Grid.Row="3" Spacing="12" Margin="0,16,0,0">
                <Border Background="{ThemeResource SystemControlForegroundBaseLowBrush}"
                        Height="1" Margin="0,0,0,8" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="Prusa Connect (cloud)"
                                   FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Import your entire fleet automatically. Requires PrusaSlicer installed and signed in to Prusa Connect."
                                   Opacity="0.6" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button x:Name="RefreshCloudButton"
                            Grid.Column="1"
                            Content="Refresh"
                            VerticalAlignment="Top"
                            Click="OnRefreshCloudClick" />
                </Grid>

                <InfoBar x:Name="ConnectStatusBar"
                         IsOpen="True" IsClosable="False"
                         Severity="Informational"
                         Title="Checking…"
                         Message="Looking for a PrusaSlicer session…">
                    <InfoBar.ActionButton>
                        <Button x:Name="CopyConnectStatusButton"
                                Content="Copy"
                                Click="OnCopyConnectStatusClick"
                                Visibility="Collapsed" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <StackPanel x:Name="CloudPrintersHost" Spacing="6" />
            </StackPanel>

            <!-- Footer - also carries the SWAtt v1 creator attribution (UI-visibility requirement). -->
            <StackPanel Grid.Row="4" Spacing="2" Margin="0,8,0,0">
                <TextBlock Text="Prusa Connect Widget - created by NomadsGalaxy"
                           Opacity="0.6" FontSize="12" />
                <TextBlock Text="Licensed under OCL v1.1 + SWAtt v1 · Not affiliated with Prusa Research."
                           Opacity="0.5" FontSize="11" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
